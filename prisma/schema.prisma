generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompetitionRole {
  OWNER
  ORGANIZER
  JUDGE
  COMPETITOR
  REPRESENTATIVE
  VIEWER
}

// ─── Kasutajad ──────────────────────────────────────────────────────────────
// Süsteemiülene role: "ADMIN" | "USER" (legacy kasutajatel võib olla "ORGANIZER")

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  role          String    @default("USER")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  competitions             Competition[]
  memberOf                 CompetitionMember[]
  enteredResults           Result[]
  accounts                 Account[]
  sessions                 Session[]
  registrationApplications RegistrationApplication[]
  registrationEvents       RegistrationApplicationEvent[] @relation("RegistrationEventActor")
  competitionPhaseEvents   CompetitionPhaseEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Juurdepääsu tokenid (Kohtunikud + Võistlejad) ─────────────────────────
// type: "JUDGE" | "ATHLETE"

model AccessToken {
  id            String          @id @default(cuid())
  token         String          @unique @default(cuid())
  type          String
  name          String
  competitionId String
  competition   Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  elementId     String?
  element       ScoringElement? @relation(fields: [elementId], references: [id])
  teamId        String?
  team          Team?           @relation(fields: [teamId], references: [id])
  createdAt     DateTime        @default(now())
  lastUsedAt    DateTime?

  enteredResults Result[]
}

// ─── Võistlus ───────────────────────────────────────────────────────────────
// status: "SETUP" | "ACTIVE" | "FINISHED"

model Competition {
  id          String    @id @default(cuid())
  name        String
  date        DateTime?
  endDate     DateTime?
  location    String?
  status      String    @default("SETUP")
  isPublic    Boolean   @default(false)
  organizerId String
  organizer   User      @relation(fields: [organizerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Hindamissüsteem
  scoringMode String @default("PENALTY") // "PENALTY" | "PLUS"

  // KP vaikeväärtused
  defaultKPMaxValue    Float @default(30)
  defaultNotPassed     Float @default(40)
  defaultPassedNotDone Float @default(35)

  // PK (Postkast) vaikeväärtused
  defaultPKMaxValue Float @default(15)

  // Vastutegevus vaikeväärtused
  defaultVastutegevusPenaltyPerLife Float @default(5)

  // Varustus vaikeväärtused
  defaultVarustusPenaltyPerItem Float @default(5)

  // Hilinemine vaikeväärtused
  defaultHilinemineMode               String @default("ONE_TIME") // "ONE_TIME" | "PER_INTERVAL"
  defaultHilinemineIntervalMinutes    Int    @default(1)
  defaultHilineminePenaltyPerInterval Float  @default(1)
  defaultHilinemineMaxPenalty         Float  @default(30)

  // Arvutusmeetodi vaikeväärtus KP/PK elementidele
  defaultCalcType         String  @default("RELATIVE_RANKING")
  defaultHigherIsBetter   Boolean @default(false)
  defaultRankingMinPoints Float   @default(0) // halvima soorituse punktid relatiivses rankingus

  // Fikseeritud pingerida vaikeväärtused — JSON massiiv kohtade kaupa
  // nt [{"place":1,"points":20},{"place":2,"points":18}]
  defaultFixedRankingPoints String @default("[]")

  // Punktide nähtavus võistlejate vaates
  athletePointsMode   String  @default("HIDDEN") // "HIDDEN" | "EXACT" | "RANGE"
  athletePointsRanges String  @default("[]") // JSON: [{maxPct:number,label:string}] (protsendipõhised vahemikud)
  athleteShowTotal    Boolean @default(false) // kuva kogusumma (täpne summa, ilma vahemiketa)
  athleteShowRank     Boolean @default(false) // kuva pingerea koht (üld + klass)

  // Registreerimise ja mandaadi avatus. override: "AUTO" | "OPEN" | "CLOSED"
  registrationOpensAt          DateTime?
  registrationClosesAt         DateTime?
  registrationOverride         String    @default("AUTO")
  registrationFinalizedAt      DateTime?
  registrationCapacity         Int?
  registrationClassBalanceMode String    @default("OFF")
  mandateOpensAt               DateTime?
  mandateClosesAt              DateTime?
  mandateOverride              String    @default("AUTO")
  mandateFinalizedAt           DateTime?

  elements                    ScoringElement[]
  teams                       Team[]
  accessTokens                AccessToken[]
  manualPenalties             ManualPenalty[]
  members                     CompetitionMember[]
  registrationClasses         CompetitionClass[]
  registrationApplications    RegistrationApplication[]
  registrationFormFields      CompetitionFormField[]
  registrationAllocationRules RegistrationAllocationRule[]
  phaseEvents                 CompetitionPhaseEvent[]
}

// Korraldaja määratud klassid. Null klassi tähendab klassideta võistlust,
// üks klass määratakse automaatselt ja mitme klassi korral valib registreerija.
model CompetitionClass {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  order         Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  applications RegistrationApplication[]

  @@unique([competitionId, name])
  @@index([competitionId, isActive, order])
}

// Registreerimisavaldus on Team-ist eraldi. Team luuakse alles osalejate
// nimekirja kinnitamisel.
model RegistrationApplication {
  id               String            @id @default(cuid())
  competitionId    String
  competition      Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  submittedById    String
  submittedBy      User              @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  teamName         String
  classId          String?
  class            CompetitionClass? @relation(fields: [classId], references: [id], onDelete: Restrict)
  status           String            @default("DRAFT")
  allocationReason String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  withdrawnAt      DateTime?
  teamId           String?           @unique
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  events      RegistrationApplicationEvent[]
  fieldValues RegistrationApplicationFieldValue[]

  @@index([competitionId, status, submittedAt])
  @@index([submittedById, createdAt])
}

// Korraldaja seadistatav registreerimise ja mandaadi vormiväli.
// options ja memberFields on JSON massiivid. semanticKey seob maakonna ja
// võistkonna liigi hilisema kohtade jaotamise reeglimootoriga.
model CompetitionFormField {
  id                     String      @id @default(cuid())
  competitionId          String
  competition            Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  key                    String
  label                  String
  helpText               String?
  type                   String
  semanticKey            String?
  options                String      @default("[]")
  memberFields           String      @default("[\"name\"]")
  showInRegistration     Boolean     @default(true)
  requiredInRegistration Boolean     @default(false)
  showInMandate          Boolean     @default(true)
  requiredInMandate      Boolean     @default(false)
  editableInMandate      Boolean     @default(true)
  conditionFieldKey      String?
  conditionOperator      String?
  conditionValue         String?
  order                  Int         @default(0)
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  registrationValues RegistrationApplicationFieldValue[]
  teamValues         TeamFormFieldValue[]
  allocationRules    RegistrationAllocationRule[]

  @@unique([competitionId, key])
  @@unique([competitionId, semanticKey])
  @@index([competitionId, isActive, order])
}

// Kohtade jaotamise reeglid. source on "CLASS" või "FORM_FIELD";
// type on "GROUP_GUARANTEE" või "PRIORITY". values on JSON massiiv.
model RegistrationAllocationRule {
  id            String                @id @default(cuid())
  competitionId String
  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  fieldId       String?
  field         CompetitionFormField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  label         String
  type          String
  source        String
  values        String                @default("[]")
  quota         Int?
  order         Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([competitionId, isActive, order])
  @@index([fieldId])
}

model RegistrationApplicationFieldValue {
  id            String                  @id @default(cuid())
  applicationId String
  application   RegistrationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldId       String
  field         CompetitionFormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value         String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([applicationId, fieldId])
  @@index([fieldId])
}

model RegistrationApplicationEvent {
  id            String                  @id @default(cuid())
  applicationId String
  application   RegistrationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  actorId       String?
  actor         User?                   @relation("RegistrationEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime                @default(now())

  @@index([applicationId, createdAt])
}

model CompetitionPhaseEvent {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phase         String
  action        String
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([competitionId, phase, createdAt])
}

// ─── Hindamiselement (KP, Postkast, Vastutegevus, Muu jne) ────────────────────
// type: "CHECKPOINT" | "PENALTY_BOX" | "MANUAL" | "OTHER"

model ScoringElement {
  id                     String      @id @default(cuid())
  competitionId          String
  competition            Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name                   String
  code                   String
  type                   String      @default("CHECKPOINT")
  order                  Int         @default(0)
  maxValue               Float?
  config                 String      @default("{}")
  createdAt              DateTime    @default(now())
  isCancelled            Boolean     @default(false)
  directPointsEntry      Boolean     @default(false)
  revealPointsToAthletes Boolean     @default(false) // kas selle elemendi punktid on võistlejatele nähtavad

  fields       FieldDefinition[]
  exceptions   ElementException[]
  calcMethod   CalcMethod?
  results      Result[]
  accessTokens AccessToken[]
  scores       ComputedScore[]
  miscEntries  MiscEntry[]
  sections     ElementSection[]

  @@unique([competitionId, code])
}

// ─── Elemendi sisendväljad ──────────────────────────────────────────────────
// type: "TIME" | "NUMBER" | "TEXT" | "COMPUTED"

model FieldDefinition {
  id              String          @id @default(cuid())
  elementId       String
  element         ScoringElement  @relation(fields: [elementId], references: [id], onDelete: Cascade)
  sectionId       String?
  section         ElementSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  name            String
  label           String
  type            String
  order           Int             @default(0)
  isResultField   Boolean         @default(false)
  rankingPriority Int?
  formula         String?
  meta            String?
  validation      String? // JSON: { required?, min?, max?, integer? }
}

// ─── Arvutusmeetod ──────────────────────────────────────────────────────────
// type: "RELATIVE_RANKING" | "ABSOLUTE_TIME" | "ABSOLUTE_POINTS" | "CUSTOM"

model CalcMethod {
  id            String         @id @default(cuid())
  elementId     String         @unique
  element       ScoringElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  type          String
  params        String         @default("{}")
  customFormula String?
}

// ─── Erandid ─────────────────────────────────────────────────────────────────

model ElementException {
  id        String         @id @default(cuid())
  elementId String
  element   ScoringElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  label     String
  penalty   Float
  order     Int            @default(0)
}

// ─── Võistkonnad ─────────────────────────────────────────────────────────────

model Team {
  id                  String      @id @default(cuid())
  competitionId       String
  competition         Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name                String
  code                String
  class               String?
  isHorsDeCompetition Boolean     @default(false)
  createdAt           DateTime    @default(now())
  workflowUpdatedAt   DateTime    @default(now()) @updatedAt

  // Registreerimine: "DRAFT" | "SUBMITTED" | "APPROVED" | "CHANGES_REQUESTED"
  registrationStatus      String    @default("DRAFT")
  registrationSubmittedAt DateTime?
  registrationReviewedAt  DateTime?
  registrationReviewNote  String?

  // Mandaat: "DRAFT" | "SUBMITTED" | "APPROVED" | "CHANGES_REQUESTED"
  mandateStatus      String    @default("DRAFT")
  mandateSubmittedAt DateTime?
  mandateReviewedAt  DateTime?
  mandateReviewNote  String?

  dnfFromElementOrder Int?
  dnfReason           String?
  hcFromElementOrder  Int? // Arvestusväline alates selle järjekorraga elemendist (null = pole)
  dqFromElementOrder  Int? // Diskvalifitseeritud alates elemendist (ainult märge pingereas)
  dnsFlag             Boolean @default(false) // Ei startinud (ainult märge pingereas)

  members                 TeamMember[]
  results                 Result[]
  accessTokens            AccessToken[]
  manualPenalties         ManualPenalty[]
  scores                  ComputedScore[]
  miscEntries             MiscEntry[]
  representative          TeamRepresentative?
  registrationApplication RegistrationApplication?
  formValues              TeamFormFieldValue[]

  @@unique([competitionId, code])
  @@unique([id, competitionId])
  @@index([competitionId, registrationStatus])
  @@index([competitionId, mandateStatus])
}

model TeamFormFieldValue {
  id        String               @id @default(cuid())
  teamId    String
  team      Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fieldId   String
  field     CompetitionFormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([teamId, fieldId])
  @@index([fieldId])
}

// role: "COMPETITOR" | "SUPPORT"

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name   String
  role   String @default("COMPETITOR")
}

// ─── Tulemused ───────────────────────────────────────────────────────────────

model Result {
  id               String         @id @default(cuid())
  elementId        String
  element          ScoringElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  teamId           String
  team             Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  values           String         @default("{}")
  exceptionLabel   String?
  exceptionPenalty Float?
  enteredByUserId  String?
  enteredByUser    User?          @relation(fields: [enteredByUserId], references: [id])
  enteredByTokenId String?
  enteredByToken   AccessToken?   @relation(fields: [enteredByTokenId], references: [id])
  enteredAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([elementId, teamId])
}

// ─── Arvutatud skoorid ────────────────────────────────────────────────────────

model ComputedScore {
  id            String         @id @default(cuid())
  elementId     String
  element       ScoringElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  penaltyPoints Float
  rankInElement Int?
  computedAt    DateTime       @default(now())

  @@unique([elementId, teamId])
}

// ─── Käsitsi karistused ───────────────────────────────────────────────────────

model ManualPenalty {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  description   String
  points        Float
  enteredById   String
  enteredAt     DateTime    @default(now())
}

// ─── Muu elemendi kanded ─────────────────────────────────────────────────────

model MiscEntry {
  id               String         @id @default(cuid())
  elementId        String
  element          ScoringElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  teamId           String
  team             Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  points           Float
  description      String
  reason           String? // Katkestanud liikme põhjus (valikuline)
  abandonElementId String? // Millisel KP-l/elemendil liige katkestas (valikuline)
  abandonTime      String? // Katkestamise kellaaeg (valikuline)
  createdAt        DateTime       @default(now())
}

// ─── Kombineeritud hindamise sektsioonid ──────────────────────────────────────

model ElementSection {
  id        String         @id @default(cuid())
  elementId String
  element   ScoringElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  name      String
  order     Int            @default(0)
  maxValue  Float?

  fields     FieldDefinition[]
  calcMethod SectionCalcMethod?
}

model SectionCalcMethod {
  id            String         @id @default(cuid())
  sectionId     String         @unique
  section       ElementSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type          String
  params        String         @default("{}")
  customFormula String?
}

// ─── Kaas-korraldajad ─────────────────────────────────────────────────────────

model CompetitionMember {
  id               String                  @id @default(cuid())
  competitionId    String
  competition      Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt          DateTime                @default(now())
  roles            CompetitionMemberRole[]
  representedTeams TeamRepresentative[]

  @@unique([competitionId, userId])
  @@unique([id, competitionId])
}

model CompetitionMemberRole {
  memberId String
  member   CompetitionMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     CompetitionRole
  addedAt  DateTime          @default(now())

  @@id([memberId, role])
  @@index([role])
}

// Ühel võistkonnal on kuni üks esindaja; üks esindaja võib hallata mitut võistkonda.
// Komposiitvõtmed tagavad, et võistkond ja esindaja kuuluvad samale võistlusele.
model TeamRepresentative {
  id            String            @id @default(cuid())
  competitionId String
  teamId        String            @unique
  team          Team              @relation(fields: [teamId, competitionId], references: [id, competitionId], onDelete: Cascade)
  memberId      String
  member        CompetitionMember @relation(fields: [memberId, competitionId], references: [id, competitionId], onDelete: Cascade)
  addedAt       DateTime          @default(now())

  @@unique([teamId, competitionId])
  @@index([memberId])
}
