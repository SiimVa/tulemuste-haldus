{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".test-dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/lib/formula.ts",
    "src/lib/fieldValidation.ts",
    "src/lib/permissions.ts",
    "src/lib/registrationClasses.ts",
    "src/lib/registrationForm.ts",
    "src/lib/teamWorkflow.ts",
    "tests/**/*.test.ts"
  ]
}
