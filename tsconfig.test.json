{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".test-dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/formula.ts",
    "src/lib/fieldValidation.ts",
    "src/lib/competitionRoleManagement.ts",
    "src/lib/competitionRoleInvitations.ts",
    "src/lib/competitionCopy.ts",
    "src/lib/permissions.ts",
    "src/lib/registrationAccess.ts",
    "src/lib/registrationAccess.server.ts",
    "src/lib/registrationAllocation.ts",
    "src/lib/registrationClasses.ts",
    "src/lib/registrationForm.ts",
    "src/lib/notifications.ts",
    "src/lib/teamWorkflow.ts",
    "src/lib/classGroups.ts",
    "src/lib/calculators/index.ts",
    "tests/**/*.test.ts"
  ]
}
