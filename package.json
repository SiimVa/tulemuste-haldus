{
  "name": "tulemuste-haldus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "db:up": "docker compose -f compose.postgres.yml up -d --wait",
    "db:down": "docker compose -f compose.postgres.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:migrate-from-sqlite": "prisma generate && prisma generate --schema prisma/schema.sqlite.prisma && node scripts/migrate-sqlite-to-postgres.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e:ui": "npm run build",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:server": "node scripts/prepare-e2e.mjs && next start --hostname 127.0.0.1 --port 3100"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@tailwindcss/postcss": "^4.3.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "^15.5.21",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.79.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.18",
    "next": {
      "sharp": "0.35.0"
    }
  }
}
